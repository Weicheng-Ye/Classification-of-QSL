Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "Symmetry-enriched Z2 and ",
 Cell[BoxData[
  FormBox["Z4", TraditionalForm]],ExpressionUUID->
  "af90d64f-a497-468e-b81f-94af59f0c37e"],
 " topological quantum spin liquids"
}], "Title",
 CellChangeTimes->{{3.984362676279476*^9, 3.984362682233079*^9}, {
  3.984362716783511*^9, 
  3.984362730656033*^9}},ExpressionUUID->"5880d53d-a1dd-4e5b-9f60-\
aa3e84f9577f"],

Cell["\<\
This notebook contains the results for all the possible symmetry \
fractionalization patterns for p6m*O(3)T, p6m*Z2T, p4m*O(3)T, p4m*Z2T acting \
on Z2 and Z4 TOs, respectively.

All anyon permutation patterns are indexed according to Table XXI of the paper.
All symmetry fractionalization classes are in terms of expansion coefficients \
of the generators in Table XXI of the paper.\
\>", "Text",
 CellChangeTimes->{{3.984362812764429*^9, 3.984362895302642*^9}, {
  3.9843630861605043`*^9, 3.984363088807485*^9}, {3.98436391697355*^9, 
  3.984363917441231*^9}},ExpressionUUID->"7bc39b62-6092-420c-bf08-\
5e574049c249"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}]}], "Code",
 CellChangeTimes->{{3.98436319812368*^9, 3.984363212908607*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"5da4b24e-f3c9-4739-b888-4562001d8977"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Load", " ", "first", " ", "file", " ", "into", " ", "Z2", " ", 
    "context"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Begin", "[", "\"\<Z2`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"<<", " ", "\"\<Z2TO.m\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"End", "[", "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Load", " ", "second", " ", "file", " ", "into", " ", "Z4", " ", 
     "context"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Begin", "[", "\"\<Z4`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"<<", " ", "\"\<Z4TO.m\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"End", "[", "]"}], ";"}]}]}]], "Code",
 CellChangeTimes->{{3.984362971017991*^9, 3.984362975578218*^9}, 
   3.984363209495875*^9},
 CellLabel->"In[19]:=",ExpressionUUID->"af150790-b5bb-4c4d-8c77-302a003010fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PrintResultLengths", "[", 
   RowBox[{
   "name_String", ",", " ", "generateFunc_", ",", " ", "actions_List", ",", 
    " ", "homotopyList_List"}], "]"}], " ", ":=", " ", "\n", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"res", ",", " ", "lengths"}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<--- \>\"", ",", " ", "name", ",", " ", "\"\< ---\>\""}], 
      "]"}], ";", "\n", "  ", 
     RowBox[{"Do", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Check", "[", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"res", " ", "=", " ", 
           RowBox[{"generateFunc", "[", 
            RowBox[{"action", ",", " ", "homotopyList"}], "]"}]}], ";", "\n", 
          "    ", 
          RowBox[{"lengths", " ", "=", " ", 
           RowBox[{"Length", " ", "/@", " ", "res"}]}], ";", "\n", "    ", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<Action \>\"", ",", " ", "action", ",", 
            " ", "\"\<  homotopy: \>\"", ",", " ", "homotopyList", ",", 
            " ", "\"\< -> lengths: \>\"", ",", " ", "lengths"}], "]"}]}], ",",
          "\n", "    ", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Equivalent", " ", "to", " ", "the", " ", "except", " ", "block"}], 
          " ", "*)"}], "\n", "    ", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Action \>\"", ",", " ", "action", ",", 
           " ", "\"\<  Error occurred.\>\""}], "]"}]}], "\n", "   ", "]"}], ",",
        "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"action", ",", " ", "actions"}], "}"}]}], "\n", "  ", "]"}], 
     ";"}]}], "\n", " ", "]"}]}]], "Code",
 CellChangeTimes->{3.984362937218369*^9},
 CellLabel->"In[25]:=",ExpressionUUID->"7bbe8251-61ec-429e-8ced-2eefb0946e26"],

