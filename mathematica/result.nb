Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Given", " ", "a", " ", "symmetry"}], "-", 
     RowBox[{
     "enriched", " ", "Z2", " ", "topological", " ", "quantum", " ", "spin", " ",
       "liquids", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "the", " ", "first", " ", "entry", " ", "is", " ", "the", " ", 
         "anyon", " ", "permutation", " ", "pattern"}], ",", " ", 
        RowBox[{
        "the", " ", "second", " ", "entry", " ", "and", " ", "the", " ", 
         "third", " ", "entry", " ", "are", " ", "symmetry", " ", 
         "fractionalization", " ", "classes"}]}], ")"}]}]}], ",", " ", 
    RowBox[{
    "check", " ", "which", " ", "lattice", " ", "homotopy", " ", "class", " ",
